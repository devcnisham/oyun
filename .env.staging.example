# Staging: a separate Supabase project (oyun-staging), never the live one. Copy to .env.staging.local and fill
# in the secret. `npm run dev:staging` reads it, refuses to start if it points at production, and runs the app
# with relational slots on (OYUN_V2_SLOTS=1). Safe to commit: it holds no secret.

# oyun-staging (Supabase ref lfcyekfjwhaeihesdyxo). The publishable key is meant for browsers.
NEXT_PUBLIC_SUPABASE_URL=https://lfcyekfjwhaeihesdyxo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bb3Uczj7xJRaeYewWEYGWQ_A4lg3iRd
# Supabase dashboard -> oyun-staging -> Project Settings -> API Keys -> Secret key (sb_secret_...). Server only.
SUPABASE_SECRET_KEY=

# Relational slots on, as they will be after the cutover
OYUN_V2_SLOTS=1

# Local logins for staging only; choose your own (SESSION_SECRET at least 32 characters, passwords at least 12)
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CRON_SECRET=

# Leave payments in test mode on staging
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
