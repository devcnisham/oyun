# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for deployments.

# Supabase (Project Settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://duwkypegndkkgfzjgiok.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): server only, never prefix with NEXT_PUBLIC_.
# Without it the app falls back to a local JSON file in .data/.
SUPABASE_SECRET_KEY=

# Relational slot booking (oyun schema). Leave unset/0 for launch: bookings, holds, blocks and pricing are
# saved in the main store and guarded by the unique slot indexes. Set to 1 only after the v2 read/write
# layer ships (see docs/SLOT-BOOKING-DB.md); setting it hides these tables from the store.
OYUN_V2_SLOTS=

# Public site address (canonical URLs, sitemap, social previews). Set before building.
NEXT_PUBLIC_SITE_URL=https://www.oyun.co.in
# Footer social links; leave empty to hide them
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Google Search Console "HTML tag" verification code (content value only)
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (loads only after cookie consent)
NEXT_PUBLIC_GA_ID=

# Optional Slack/Discord webhook for error alerts
ERROR_WEBHOOK_URL=

# Clerk: player sign-in / sign-up (dashboard.clerk.com → your app → API keys).
# Leave empty to keep /login and /signup in "coming soon" mode.
# Google and Apple sign-in: enable each under Clerk dashboard → User & authentication → Social connections.
# They then appear on /login and /signup automatically; no code change needed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Signs partner/admin login cookies. Random, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Admin login (password at least 12 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional OYUN operations login for the partner dashboard (manages the launch turfs until each owner joins).
# Password at least 12 characters.
PARTNER_EMAIL=
# Emails (comma separated) that may sign in as the OYUN operations account with Google or Apple through Clerk. Not a secret.
OPS_GOOGLE_EMAILS=
PARTNER_PASSWORD=

# Shared secret for the scheduled routes (/api/cron/payouts/settle, /api/cron/retention-purge).
# Required: with it empty both routes refuse every call. Vercel Cron sends it as a Bearer token.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Razorpay (Razorpay dashboard > Settings > API keys / Webhooks). Server only.
# Without RAZORPAY_WEBHOOK_SECRET the webhook refuses every call in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
