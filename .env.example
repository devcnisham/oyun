# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for deployments.

# Supabase (Project Settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://nimfjwxzolkwiyqmnaat.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_LJIxyNP1UF6Wf0QbZR5y5Q_ZvOsY9De
# Secret key (sb_secret_...): server only, never prefix with NEXT_PUBLIC_.
# Without it the app falls back to a local JSON file in .data/.
SUPABASE_SECRET_KEY=

# Public site address (canonical URLs, sitemap, social previews). Set before building.
NEXT_PUBLIC_SITE_URL=https://oyun.in

# Google Search Console "HTML tag" verification code (content value only)
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (loads only after cookie consent)
NEXT_PUBLIC_GA_ID=

# Optional Slack/Discord webhook for error alerts
ERROR_WEBHOOK_URL=

# Signs partner/admin login cookies. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Demo partner account created when the database is first seeded
PARTNER_EMAIL=partner@oyun.in
PARTNER_PASSWORD=

# Show one-click "See Demo" buttons on the login pages (true/false)
DEMO_LOGIN=false
