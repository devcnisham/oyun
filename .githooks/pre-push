#!/bin/sh
# Runs before git push: prevents accidental direct push to main without a pull request.
# Skip for emergency hotfixes with: ALLOW_MAIN_PUSH=1 git push
set -e

remote="$1"
url="$2"

while read local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$ALLOW_MAIN_PUSH" != "1" ]; then
    echo ""
    echo "======================================================================"
    echo "✖ BLOCKED: Direct push to 'main' is prevented by branch protection rules."
    echo "  Please push your changes to a feature branch (e.g. feature/<feature>)"
    echo "  and open a Pull Request to merge into main."
    echo ""
    echo "  For emergency hotfixes, bypass with: ALLOW_MAIN_PUSH=1 git push"
    echo "======================================================================"
    echo ""
    exit 1
  fi
done

exit 0
